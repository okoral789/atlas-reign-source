require("./prelude")
local Demo=require("../src/client/UI/ArsenalDemo")
local Rules=require("../src/shared/Core/Rules")
local Defs=require("../src/shared/Core/Defs")
local normal=Demo.reinforcement_example(60000,100000)
assert(normal.gain==20000 and normal.after==80000 and normal.cap==100000)
local capped=Demo.reinforcement_example(95000,100000)
assert(capped.gain==5000 and capped.after==100000)
assert(Demo.reinforcement_example(100000,100000).gain==0)
assert(Demo.spec("reinforce").cost==Rules.REINFORCE_COST)
assert(Demo.spec("reinforce").cooldown==Rules.REINFORCE_COOLDOWN_TICKS/Defs.TICK_RATE)
for _,key in {"atom","hydrogen","mirv","mega","scatter"} do
 assert(Demo.spec(key).cost==Rules.nuke_cost(key,0) and Demo.spec(key).cost>0,"never show a numeric-kind -1 cost")
 assert(#Demo.spec(key).facts==3)
 assert(#Demo.spec(key).summary<65 and #Demo.spec(key).details<110)
end
assert(Demo.spec("mirv").facts[1]:find(tostring(Rules.MIRV_WARHEADS)))
assert(Demo.spec("unknown")==nil and Demo.spec("railgun")==nil and Demo.spec("emp")==nil)
local repair=Demo.spec("fleet_repair")
assert(repair.cost==Rules.SUPPORT.fleet_repair.cost and repair.cooldown==Rules.SUPPORT.fleet_repair.cooldown/Defs.TICK_RATE)
assert(#repair.summary<65 and #repair.details<110 and #repair.facts==3)
print("PASS Armory demos: positive actual costs, concise summaries, capped troop gain, bonus bomb previews")
